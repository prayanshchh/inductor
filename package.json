{
  "name": "inductor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm ci --prefix crates/provider-claude/js",
    "tui": "bun --cwd packages/tui dev",
    "typecheck": "bun --cwd packages/tui typecheck",
    "test:tui": "bun --cwd packages/tui test"
  }
}
